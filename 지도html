          <path d="M382 214 Q356 274 340 330" stroke-width="2.4"/>
          <path d="M888 116 Q904 200 872 288" stroke-width="2.6"/>
        </g>

        <!-- ── TRADE ROUTES ── -->
        <g id="L-routes" class="layer off" fill="none" stroke="#CBA135" stroke-width="1.8" stroke-dasharray="9 8" opacity=".8">
          <path d="M480 780 Q660 800 890 820"/>
          <path d="M480 780 Q760 700 1210 512"/>
          <path d="M430 610 Q380 700 470 780"/>
          <path d="M796 520 Q860 620 900 818"/>
          <path d="M796 520 Q1000 300 1210 512"/>
          <path d="M930 208 Q1080 260 1210 512"/>
          <path d="M930 208 Q640 300 430 610"/>
          <path d="M120 690 Q240 640 330 268"/>
          <g fill="#CBA135" stroke="none" font-family="ui-monospace,monospace" font-size="9.5" letter-spacing="1.4">
            <text x="640" y="792" opacity=".9">대상로</text>
            <text x="1000" y="352" opacity=".9">균열 우회로</text>
            <text x="196" y="470" opacity=".9">밀무역 항로</text>
          </g>
        </g>

        <!-- ── RIFT (signature) ── -->
        <g id="L-rift" class="layer">
          <path d="M890 344 L946 396 L912 438 L978 470 L930 520 L1000 548 L952 606 L1014 646 L960 700 L878 664 Q828 566 838 470 Q848 386 890 344 Z"
                fill="#150807" stroke="#3A130C" stroke-width="2"/>
          <path class="ember-core" style="transform-origin:930px 520px" filter="url(#glow)"
                d="M902 372 L938 412 L910 444 L964 474 L926 518 L982 546 L944 596 L992 638 L948 682 L890 652 Q852 562 860 474 Q868 402 902 372 Z"
