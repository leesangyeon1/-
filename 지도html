<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>재의 상흔 — 대륙 측량도</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;500;700&family=Noto+Sans+KR:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root{
  --plate:#0A1F1E; --plate2:#0F2C29; --plate3:#143733;
  --sea:#0A2A33; --sea2:#082129;
  --brass:#CBA135; --brass2:#8C6F2A; --brass3:#5A4A22;
  --bone:#E9E1CB; --bone-dim:#9FA396;
  --ember:#E4622F; --ash:#B0342A;
  --pos:#4FA37F; --neg:#C0503F;
  --serif:'Noto Serif KR',Georgia,serif;
  --sans:'Noto Sans KR',system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; background:var(--plate); color:var(--bone);
  font-family:var(--sans); font-weight:300; line-height:1.7;
  background-image:
    radial-gradient(ellipse at 20% 0%, #16403A 0%, transparent 55%),
    radial-gradient(ellipse at 90% 100%, #12332F 0%, transparent 50%);
}
.wrap{max-width:1500px;margin:0 auto;padding:0 24px 120px}

/* ── plate header ── */
header{padding:72px 0 40px;border-bottom:1px solid var(--brass3);position:relative}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.34em;color:var(--brass2);text-transform:uppercase}
h1{font-family:var(--serif);font-weight:700;font-size:clamp(38px,7vw,88px);line-height:.98;margin:18px 0 0;letter-spacing:-.02em}
h1 em{font-style:normal;color:var(--ember)}
.tagline{font-family:var(--serif);font-weight:300;font-size:clamp(15px,2vw,20px);color:var(--bone-dim);margin-top:20px;max-width:60ch}
.coordstrip{display:flex;flex-wrap:wrap;gap:28px;margin-top:34px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--brass2)}
.coordstrip span b{color:var(--bone);font-weight:400}

/* ── sections ── */
section{padding-top:88px}
.sec-head{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;margin-bottom:8px}
.sec-num{font-family:var(--mono);font-size:12px;letter-spacing:.2em;color:var(--brass2)}
h2{font-family:var(--serif);font-weight:500;font-size:clamp(24px,3.4vw,38px);margin:0;letter-spacing:-.01em}
.sec-sub{color:var(--bone-dim);font-size:14px;max-width:72ch;margin:0 0 30px}

/* ── controls ── */
.controls{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.tog{
  font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;
  background:transparent;color:var(--brass2);border:1px solid var(--brass3);
  padding:9px 15px;cursor:pointer;transition:.18s;border-radius:1px;
}
.tog:hover{color:var(--bone);border-color:var(--brass2)}
.tog[aria-pressed="true"]{background:var(--brass);color:#0A1F1E;border-color:var(--brass);font-weight:600}
.tog:focus-visible{outline:2px solid var(--ember);outline-offset:2px}

/* ── map layout ── */
.maparea{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:22px;align-items:start}
.mapbox{border:1px solid var(--brass3);background:var(--sea2);position:relative;overflow:hidden}
svg.map{display:block;width:100%;height:auto}
.panel{border:1px solid var(--brass3);background:var(--plate2);padding:22px;position:sticky;top:20px}
.panel .pname{font-family:var(--serif);font-size:23px;font-weight:500;margin:0}
.panel .psub{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:var(--brass2);text-transform:uppercase;margin-top:5px}
.panel dl{margin:20px 0 0;display:grid;grid-template-columns:auto 1fr;gap:9px 14px;font-size:13px}
.panel dt{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--brass2);text-transform:uppercase;padding-top:3px;white-space:nowrap}
.panel dd{margin:0;color:var(--bone)}
.idbadges{display:flex;flex-wrap:wrap;gap:5px;margin-top:16px}
.idb{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;border:1px solid var(--brass3);color:var(--bone-dim);padding:3px 7px}
.hintline{font-size:12px;color:var(--bone-dim);margin-top:18px;border-top:1px solid var(--brass3);padding-top:14px}

/* ── legend ── */
.legend{display:flex;flex-wrap:wrap;gap:6px 22px;margin-top:14px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--bone-dim)}
.legend i{display:inline-block;width:11px;height:11px;margin-right:7px;vertical-align:-1px;border:1px solid rgba(0,0,0,.35)}

/* ── graph ── */
.grapharea{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:22px;align-items:start}
.graphbox{border:1px solid var(--brass3);background:var(--plate2)}
svg.graph{display:block;width:100%;height:auto}
.scalebar{height:9px;background:linear-gradient(90deg,#C0503F,#8A4438,#3A4340,#3E7A62,#4FA37F);margin-top:12px;border:1px solid var(--brass3)}
.scalelab{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--brass2);margin-top:6px}

/* ── matrix ── */
.mtxscroll{overflow-x:auto;border:1px solid var(--brass3);background:var(--plate2)}
table.mtx{border-collapse:collapse;font-family:var(--mono);font-size:11px;min-width:760px;width:100%}
table.mtx th{font-weight:400;color:var(--brass2);letter-spacing:.06em;padding:9px 6px;white-space:nowrap;font-size:10px}
table.mtx th.rowh{text-align:right;position:sticky;left:0;background:var(--plate2);z-index:1;color:var(--bone);padding-right:12px}
table.mtx td{text-align:center;padding:8px 4px;color:#0A1F1E;font-weight:600;letter-spacing:.02em}
table.mtx td.self{background:var(--plate3);color:var(--brass3)}
table.mtx tr:hover td{outline:1px solid rgba(203,161,53,.35)}

/* ── cards ── */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:16px;margin-top:26px}
.card{border:1px solid var(--brass3);background:var(--plate2);padding:20px}
.card h3{font-family:var(--serif);font-size:18px;font-weight:500;margin:0 0 3px}
.card .ct{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--brass2);text-transform:uppercase}
.card p{font-size:13px;color:var(--bone-dim);margin:13px 0 0}
.card .hl{color:var(--bone)}

footer{margin-top:96px;padding-top:26px;border-top:1px solid var(--brass3);font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--brass3);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}

/* ── svg element styles ── */
.region{cursor:pointer;transition:filter .2s}
.region:hover{filter:brightness(1.28)}
.region.dim{opacity:.28}
.rlabel{font-family:var(--mono);font-size:12.5px;letter-spacing:.22em;fill:var(--bone);opacity:.62;pointer-events:none;text-transform:uppercase}
.sealabel{font-family:var(--serif);font-size:16px;font-style:italic;fill:#4E8296;opacity:.85;pointer-events:none;letter-spacing:.16em}
.fname{font-family:var(--serif);font-size:17px;font-weight:500;fill:var(--bone);pointer-events:none}
.fcap{font-family:var(--mono);font-size:10px;letter-spacing:.1em;fill:var(--brass2);pointer-events:none}
.layer{transition:opacity .35s}
.layer.off{opacity:0;pointer-events:none}
.ember-core{animation:breathe 7s ease-in-out infinite}
.shimmer{animation:shimmer 4.5s ease-in-out infinite}
@keyframes breathe{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:.95;transform:scale(1.045)}}
@keyframes shimmer{0%,100%{opacity:.2}50%{opacity:.6}}
.edge{transition:opacity .2s,stroke-width .2s}
.node{cursor:pointer}
.node circle{transition:.2s}
.node:hover circle{stroke-width:3}
.nlabel{font-family:var(--sans);font-size:13px;font-weight:400;fill:var(--bone);pointer-events:none}
.nval{font-family:var(--mono);font-size:10px;fill:var(--bone-dim);pointer-events:none}
.faded{opacity:.07}

@media (max-width:980px){
  .maparea,.grapharea{grid-template-columns:1fr}
  .panel{position:static}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="eyebrow">대륙 측량도 · 제 1 판 · 스토리보드 v0.1</div>
  <h1>재의 <em>상흔</em></h1>
  <p class="tagline">열한 개의 세력이 하나의 대륙을 나눠 가졌다. 그중 열 개는 각자의 이유로 옳고, 하나는 이유를 갖지 않는다.</p>
  <div class="coordstrip">
    <span>세력 <b>11</b></span>
    <span>기후대 <b>9</b></span>
    <span>라이벌 전선 <b>4</b></span>
    <span>계절 이벤트 <b>3</b></span>
    <span>승리 경로 <b>3</b></span>
  </div>
</header>

<!-- ══════════ MAP ══════════ -->
<section id="map">
  <div class="sec-head"><span class="sec-num">Ⅰ</span><h2>대륙</h2></div>
  <p class="sec-sub">서반부는 구세계 — 제국·교단·산맥·사막·군도가 천 년째 같은 싸움을 반복한다. 동반부는 균열 변경 — 네 개의 도시국가 연합이 재의 상흔을 사방에서 둘러싸고 있다. 지역을 눌러 상세를 확인하세요.</p>

  <div class="controls" id="layerCtl">
    <button class="tog" data-layer="terrain" aria-pressed="true">지형</button>
    <button class="tog" data-layer="climate" aria-pressed="false">기후</button>
    <button class="tog" data-layer="rivers" aria-pressed="true">수계</button>
    <button class="tog" data-layer="routes" aria-pressed="false">교역로</button>
    <button class="tog" data-layer="factions" aria-pressed="true">세력</button>
    <button class="tog" data-layer="rift" aria-pressed="true">균열</button>
  </div>

  <div class="maparea">
    <div class="mapbox">
      <svg class="map" viewBox="0 0 1440 1000" role="img" aria-label="대륙 지도">
        <defs>
          <radialGradient id="seaGrad" cx="50%" cy="50%" r="75%">
            <stop offset="0%" stop-color="#0D3641"/><stop offset="100%" stop-color="#061A21"/>
          </radialGradient>
          <radialGradient id="emberGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FFD27A"/><stop offset="35%" stop-color="#E4622F"/>
            <stop offset="75%" stop-color="#8C2A17"/><stop offset="100%" stop-color="#2A0F0A"/>
          </radialGradient>
          <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="16" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <pattern id="wave" width="26" height="14" patternUnits="userSpaceOnUse">
            <path d="M0 8 q6.5 -6 13 0 t13 0" fill="none" stroke="#1B4E5C" stroke-width="1" opacity=".5"/>
          </pattern>
          <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="7" stroke="#0A1F1E" stroke-width="1.6" opacity=".28"/>
          </pattern>
        </defs>

        <!-- ocean -->
        <rect width="1440" height="1000" fill="url(#seaGrad)"/>
        <rect width="1440" height="1000" fill="url(#wave)"/>

        <!-- base continent silhouette -->
        <path d="M232 300 Q210 200 300 168 L430 160 Q470 178 468 232 L560 268 Q700 236 760 104 L1122 84 Q1176 168 1152 276 L1300 292 Q1372 340 1366 520 Q1360 690 1268 748 L1170 762 Q1180 860 1096 928 L800 932 Q690 900 682 826 L660 866 Q520 906 414 888 Q296 862 294 792 L276 690 Q262 560 282 470 Z"
              fill="#1C3C33" stroke="none"/>

        <!-- ── TERRAIN LAYER ── -->
        <g id="L-terrain" class="layer">
          <!-- 신성반도 -->
          <path class="region" data-f="chu" d="M232 300 Q210 200 300 168 L430 160 Q470 180 466 234 L440 322 Q360 372 300 356 Z" fill="#5C6B58"/>
          <!-- 제국 -->
          <path class="region" data-f="emp" d="M300 356 Q360 372 440 322 L466 234 L556 270 L602 400 Q616 520 566 612 Q470 690 388 668 Q292 634 284 528 Q276 434 300 356 Z" fill="#6E7042"/>
          <!-- 내해 -->
          <ellipse cx="432" cy="474" rx="86" ry="98" fill="#0D3B47"/>
          <ellipse cx="432" cy="474" rx="86" ry="98" fill="url(#wave)"/>
          <!-- 대장벽 산맥 -->
