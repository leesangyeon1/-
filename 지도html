 'reb-nor':[10,'한대수렵 생계 일치 +15 · 거리 −5'],
 'reb-eas':[-5,'접점 희박'],
 'reb-aby':[-60,'산맥이 균열의 북쪽 통로 −60'],
 'chu-cov':[-75,'라이벌 −60 · 근친증오(같은 경전) −15'],
 'chu-pir':[-35,'순례선 약탈 −35'],
 'chu-tri':[-20,'정령신앙을 우상으로 규정 −20'],
 'chu-wes':[-20,'기계신앙을 이단으로 규정 −20'],
 'chu-sou':[-15,'정령신앙 −15'],
 'chu-nor':[-25,'조상숭배를 우상숭배로 규정 −25'],
 'chu-eas':[0,'거리와 무관심'],
 'chu-aby':[-100,'절대악으로 교리에 명시 −100'],
 'cov-pir':[15,'밀무역 파트너 +15'],
 'cov-tri':[5,'간접 교역 +5'],
 'cov-wes':[10,'광물 교역 +10'],
 'cov-sou':[25,'생계 일치 +15 · 사막–사바나 대상로 +10'],
 'cov-nor':[0,'접점 없음'],
 'cov-eas':[20,'대륙 횡단 교역 +20'],
 'cov-aby':[-80,'경전이 균열을 부정으로 규정 −80'],
 'pir-tri':[-70,'라이벌 −60 · 영토 청구권 −10'],
 'pir-wes':[10,'화약·부품 밀거래 +10'],
 'pir-sou':[-10,'연안 약탈 −10'],
 'pir-nor':[15,'해양 생계 일치 +15 · 약탈 문화 공유'],
 'pir-eas':[-20,'상선 피해 −20'],
 'pir-aby':[-50,'교역 붕괴 위협 −50'],
 'tri-wes':[-5,'산호초 채굴 마찰 −5'],
 'tri-sou':[35,'신앙 일치 +25 · 야수 문화 공유 +10'],
 'tri-nor':[-15,'어장 경쟁 −15'],
 'tri-eas':[10,'열도 교역 +10'],
 'tri-aby':[-65,'정령의 죽음 −65'],
 'wes-sou':[30,'균열 방벽 동맹 +20 · 교역 +10'],
 'wes-nor':[25,'균열 방벽 동맹 +20 · 광물–모피 +5'],
 'wes-eas':[20,'균열 방벽 동맹 +20'],
 'wes-aby':[-100,'접경 최전선 −100'],
 'sou-nor':[15,'균열 방벽 동맹 +20 · 생계 상충 −5'],
 'sou-eas':[30,'균열 방벽 동맹 +20 · 신앙 인접 +10'],
 'sou-aby':[-100,'접경 최전선 −100'],
 'nor-eas':[20,'신앙 일치 +25 · 항로 경쟁 −5'],
 'nor-aby':[-100,'접경 최전선 −100'],
 'eas-aby':[-100,'접경 최전선 −100']
};
const RIVALS=[['emp','reb'],['chu','cov'],['pir','tri']];
const byId=Object.fromEntries(F.map(f=>[f.id,f]));
const key=(a,b)=>R[a+'-'+b]?a+'-'+b:b+'-'+a;
const rel=(a,b)=>a===b?null:R[key(a,b)];
const SVGNS='http://www.w3.org/2000/svg';
const el=(t,at={})=>{const e=document.createElementNS(SVGNS,t);for(const k in at)e.setAttribute(k,at[k]);return e;};

function relColor(v){
  if(v>0){const t=Math.min(v,100)/100;return `rgb(${Math.round(58+t*21)},${Math.round(90+t*73)},${Math.round(80+t*47)})`;}
  if(v<0){const t=Math.min(-v,100)/100;return `rgb(${Math.round(88+t*104)},${Math.round(76-t*4)},${Math.round(72-t*9)})`;}
  return '#4A5652';
}

/* ── map faction markers ── */
const fl=document.getElementById('L-factions');
F.forEach(f=>{
  const g=el('g',{class:'region',
    'data-f':f.id,style:'cursor:pointer'});
  g.appendChild(el('circle',{cx:f.mx,cy:f.my,r:16,fill:'none',stroke:f.c,'stroke-width':1.2,opacity:.5}));
  g.appendChild(el('circle',{cx:f.mx,cy:f.my,r:7,fill:f.c,stroke:'#0A1F1E','stroke-width':2}));
  const right=f.mx<1080;
  const t=el('text',{x:f.mx+(right?26:-26),y:f.my+2,class:'fname','text-anchor':right?'start':'end'});
  t.textContent=f.n; g.appendChild(t);
  const c=el('text',{x:f.mx+(right?26:-26),y:f.my+18,class:'fcap','text-anchor':right?'start':'end'});
  c.textContent=f.sub; g.appendChild(c);
  fl.appendChild(g);
});

/* rival front lines on map */
const rf=el('g',{opacity:.55});
RIVALS.forEach(([a,b])=>{
  const A=byId[a],B=byId[b];
  rf.appendChild(el('line',{x1:A.mx,y1:A.my,x2:B.mx,y2:B.my,stroke:'#C0503F','stroke-width':2,'stroke-dasharray':'3 6'}));
});
fl.insertBefore(rf,fl.firstChild);

/* ── panel ── */
const pName=document.getElementById('pName'),pSub=document.getElementById('pSub'),
      pBody=document.getElementById('pBody'),pBadges=document.getElementById('pBadges'),
      pHint=document.getElementById('pHint');
function showRegion(id){
  const f=byId[id];
  pName.textContent=f.n; pName.style.color=f.c;
  pSub.textContent=f.sub;
  pBody.innerHTML=[['목표',f.goal],['기후',f.climate],['지형',f.terrain],['전술',f.tactic],['특이',f.quirk],['거점',f.cap]]
    .map(([k,v])=>`<dt>${k}</dt><dd>${v}</dd>`).join('');
  pBadges.innerHTML=[['혈통',f.blood],['신앙',f.creed],['생계',f.live]]
    .map(([k,v])=>`<span class="idb">${k} · ${v}</span>`).join('');
  const rv=f.rival==='all'?'전 세력':(byId[f.rival]?byId[f.rival].n:'—');
  pHint.textContent='라이벌 전선 — '+rv;
  document.querySelectorAll('.region').forEach(r=>r.classList.toggle('dim',r.dataset.f!==id));
}
document.querySelectorAll('.region').forEach(r=>{
  r.addEventListener('click',()=>showRegion(r.dataset.f));
  r.addEventListener('mouseenter',()=>showRegion(r.dataset.f));
});
document.querySelector('svg.map').addEventListener('mouseleave',()=>{
  document.querySelectorAll('.region').forEach(r=>r.classList.remove('dim'));
});

/* ── layer toggles ── */
document.getElementById('layerCtl').addEventListener('click',e=>{
  const b=e.target.closest('.tog'); if(!b)return;
  const on=b.getAttribute('aria-pressed')==='true';
  b.setAttribute('aria-pressed',String(!on));
  document.getElementById('L-'+b.dataset.layer).classList.toggle('off',on);
});

/* ── graph ── */
const eg=document.getElementById('edges'),ng=document.getElementById('nodes'),edgeEls=[];
Object.keys(R).forEach(k=>{
  const [a,b]=k.split('-'),v=R[k][0];
  if(Math.abs(v)<15)return;
  const A=byId[a],B=byId[b];
  const isRival=RIVALS.some(([x,y])=>(x===a&&y===b)||(x===b&&y===a));
  const ln=el('line',{x1:A.gx,y1:A.gy,x2:B.gx,y2:B.gy,class:'edge',
    stroke:relColor(v),'stroke-width':(Math.abs(v)/100*5+.7).toFixed(2),
    'stroke-opacity':.72,'stroke-dasharray':v<0?(isRival?'':'7 5'):''});
  ln.dataset.a=a;ln.dataset.b=b;ln.dataset.v=v;ln.dataset.rival=isRival;
  eg.appendChild(ln);edgeEls.push(ln);
});
F.forEach(f=>{
  const g=el('g',{class:'node','data-f':f.id});
  const isAby=f.id==='aby';
  g.appendChild(el('circle',{cx:f.gx,cy:f.gy,r:isAby?24:17,fill:'#0F2C29',stroke:f.c,'stroke-width':isAby?3:2}));
  g.appendChild(el('circle',{cx:f.gx,cy:f.gy,r:isAby?11:6,fill:f.c}));
  const t=el('text',{x:f.gx,y:f.gy+(isAby?44:36),class:'nlabel','text-anchor':'middle'});
  t.textContent=f.n;g.appendChild(t);
  ng.appendChild(g);
});
const gName=document.getElementById('gName'),gSub=document.getElementById('gSub'),gBody=document.getElementById('gBody');
let focus=null,mode='all';
function applyEdges(){
  edgeEls.forEach(l=>{
    const v=+l.dataset.v;
    let ok = mode==='all' ? true : mode==='pos' ? v>0 : mode==='neg' ? v<0 : l.dataset.rival==='true';
    if(focus) ok = ok && (l.dataset.a===focus||l.dataset.b===focus);
    l.classList.toggle('faded',!ok);
  });
  document.querySelectorAll('.node').forEach(n=>{
    n.classList.toggle('faded',!!focus && n.dataset.f!==focus && !rel(focus,n.dataset.f));
  });
}
document.querySelectorAll('.node').forEach(n=>{
  n.addEventListener('click',()=>{
    const id=n.dataset.f;
    focus = focus===id ? null : id;
    if(focus){
      const f=byId[id];
      gName.textContent=f.n;gName.style.color=f.c;gSub.textContent=f.sub;
      const rows=F.filter(o=>o.id!==id).map(o=>({o,r:rel(id,o.id)})).sort((x,y)=>y.r[0]-x.r[0]);
      gBody.innerHTML=rows.map(({o,r})=>
        `<dt style="color:${relColor(r[0])}">${r[0]>0?'+':''}${r[0]}</dt><dd><b style="font-weight:600">${o.n}</b><br><span style="font-size:11.5px;color:var(--bone-dim)">${r[1]}</span></dd>`).join('');
    }else{
      gName.textContent='세력을 선택하세요';gName.style.color='';gSub.textContent='11 FACTIONS · 55 PAIRS';
      gBody.innerHTML='<dt>안내</dt><dd>노드를 누르면 그 세력이 맺은 모든 관계와 수치 근거가 표시됩니다.</dd>';
    }
    applyEdges();
  });
});
document.getElementById('edgeCtl').addEventListener('click',e=>{
  const b=e.target.closest('.tog'); if(!b)return;
  mode=b.dataset.edge;
  document.querySelectorAll('#edgeCtl .tog').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));
  applyEdges();
});

/* ── matrix ── */
const mtx=document.getElementById('mtx');
let html='<tr><th class="rowh"></th>'+F.map(f=>`<th>${f.n}</th>`).join('')+'</tr>';
F.forEach(a=>{
  html+=`<tr><th class="rowh">${a.n}</th>`;
  F.forEach(b=>{
    if(a.id===b.id){html+='<td class="self">—</td>';return;}
    const v=rel(a.id,b.id)[0];
    html+=`<td style="background:${relColor(v)}" title="${rel(a.id,b.id)[1]}">${v>0?'+':''}${v}</td>`;
  });
  html+='</tr>';
});
mtx.innerHTML=html;
</script>
</body>
</html>
