          <!-- 남부 사막 -->
          <path class="region" data-f="cov" d="M292 640 Q380 662 500 640 L646 668 Q676 760 646 848 Q500 894 402 878 Q300 856 292 780 Z" fill="#8A7040"/>
          <!-- 서부 개척지 -->
          <path class="region" data-f="wes" d="M716 484 Q724 380 668 258 L790 300 Q866 340 872 452 Q878 576 828 664 L716 690 Q654 672 654 672 Q706 610 716 484 Z" fill="#5E5B52"/>
          <!-- 북부 피오르드 -->
          <path class="region" data-f="nor" d="M760 104 L1122 84 Q1176 168 1152 276 L980 322 Q852 336 790 300 Q748 210 760 104 Z" fill="#3F5966"/>
          <!-- 동부 -->
          <path class="region" data-f="eas" d="M1080 330 L1300 292 Q1372 340 1366 520 Q1360 690 1268 748 L1146 736 Q1082 640 1074 512 Q1068 410 1080 330 Z" fill="#6B4A46"/>
          <!-- 남부 사바나 -->
          <path class="region" data-f="sou" d="M700 700 L828 664 L1060 682 L1160 758 Q1178 858 1096 928 L800 932 Q690 900 686 826 Q684 754 700 700 Z" fill="#6E7638"/>
          <!-- 군도해 섬들 -->
          <g class="region" data-f="tri">
            <path d="M148 716 Q198 682 258 712 Q294 760 268 812 Q214 856 164 828 Q126 780 148 716 Z" fill="#3B6B5C"/>
            <path d="M252 852 Q292 836 314 866 Q318 896 288 908 Q254 906 246 880 Z" fill="#3B6B5C"/>
          </g>
          <g class="region" data-f="pir">
            <path d="M84 660 Q120 636 148 664 Q156 700 124 712 Q92 706 84 660 Z" fill="#4A6373"/>
            <path d="M156 596 Q180 582 196 604 Q196 628 172 632 Q152 622 156 596 Z" fill="#4A6373"/>
            <path d="M74 776 Q106 758 128 784 Q130 816 100 822 Q72 812 74 776 Z" fill="#4A6373"/>
          </g>
          <!-- 산맥 기호 -->
          <g stroke="#2B3A32" stroke-width="2.4" fill="none" opacity=".75">
            <path d="M600 300 l14 -20 l14 20 M628 336 l14 -20 l14 20 M596 372 l14 -20 l14 20 M634 408 l14 -20 l14 20 M604 448 l14 -20 l14 20 M640 486 l14 -20 l14 20 M606 526 l14 -20 l14 20 M636 566 l14 -20 l14 20 M600 606 l14 -20 l14 20"/>
          </g>
          <!-- 메사/철도 -->
          <g stroke="#8E93A8" stroke-width="1.4" opacity=".55" fill="none">
            <path d="M744 330 L800 430 L790 560 L836 650" stroke-dasharray="1 7" stroke-linecap="round" stroke-width="3"/>
          </g>
          <!-- 사구 -->
          <g stroke="#6B5427" stroke-width="1.6" fill="none" opacity=".6">
            <path d="M330 700 q26 -12 52 0 M420 728 q26 -12 52 0 M350 780 q26 -12 52 0 M470 790 q26 -12 52 0 M400 840 q26 -12 52 0 M540 700 q26 -12 52 0 M560 828 q26 -12 52 0"/>
          </g>
          <!-- 침엽수 -->
          <g fill="#2E4A46" opacity=".75">
            <path d="M840 160 l7 16 h-14 Z M880 190 l7 16 h-14 Z M930 150 l7 16 h-14 Z M980 200 l7 16 h-14 Z M1030 160 l7 16 h-14 Z M1075 200 l7 16 h-14 Z M810 230 l7 16 h-14 Z M900 250 l7 16 h-14 Z M1000 270 l7 16 h-14 Z"/>
          </g>
          <!-- 계단식 논 -->
          <g stroke="#8A5E4A" stroke-width="1.3" fill="none" opacity=".55">
            <path d="M1120 400 q60 -18 120 -4 M1120 436 q60 -18 120 -4 M1130 472 q60 -18 120 -4 M1140 560 q60 -18 120 -4 M1150 600 q60 -18 120 -4"/>
          </g>
        </g>

        <!-- ── CLIMATE LAYER ── -->
        <g id="L-climate" class="layer off">
          <path d="M232 300 Q210 200 300 168 L430 160 Q470 180 466 234 L440 322 Q360 372 300 356 Z" fill="#6E8FA8" opacity=".62"/>
          <path d="M300 356 Q360 372 440 322 L466 234 L556 270 L602 400 Q616 520 566 612 Q470 690 388 668 Q292 634 284 528 Q276 434 300 356 Z" fill="#C7A94B" opacity=".62"/>
          <path d="M556 270 L668 258 Q724 380 716 484 Q706 610 654 672 L566 612 Q616 520 602 400 Z" fill="#8FA9C4" opacity=".62"/>
          <path d="M292 640 Q380 662 500 640 L646 668 Q676 760 646 848 Q500 894 402 878 Q300 856 292 780 Z" fill="#E0A94E" opacity=".66"/>
          <path d="M716 484 Q724 380 668 258 L790 300 Q866 340 872 452 Q878 576 828 664 L716 690 Q654 672 654 672 Q706 610 716 484 Z" fill="#B98C63" opacity=".6"/>
          <path d="M760 104 L1122 84 Q1176 168 1152 276 L980 322 Q852 336 790 300 Q748 210 760 104 Z" fill="#9FC6D6" opacity=".6"/>
          <path d="M1080 330 L1300 292 Q1372 340 1366 520 Q1360 690 1268 748 L1146 736 Q1082 640 1074 512 Q1068 410 1080 330 Z" fill="#5FA08C" opacity=".6"/>
          <path d="M700 700 L828 664 L1060 682 L1160 758 Q1178 858 1096 928 L800 932 Q690 900 686 826 Q684 754 700 700 Z" fill="#C6C05A" opacity=".6"/>
          <path d="M148 716 Q198 682 258 712 Q294 760 268 812 Q214 856 164 828 Q126 780 148 716 Z" fill="#4FBFA0" opacity=".6"/>
          <path d="M84 660 Q120 636 148 664 Q156 700 124 712 Q92 706 84 660 Z" fill="#4FBFA0" opacity=".6"/>
          <path d="M74 776 Q106 758 128 784 Q130 816 100 822 Q72 812 74 776 Z" fill="#4FBFA0" opacity=".6"/>
          <text class="rlabel" x="330" y="252" font-size="10">온대고원</text>
          <text class="rlabel" x="352" y="600" font-size="10">지중해성</text>
          <text class="rlabel" x="640" y="330" font-size="10">고산냉대</text>
          <text class="rlabel" x="420" y="770" font-size="10">고온건조</text>
          <text class="rlabel" x="742" y="420" font-size="10">반건조고원</text>
          <text class="rlabel" x="880" y="200" font-size="10">아한대</text>
          <text class="rlabel" x="1150" y="440" font-size="10">온대몬순</text>
          <text class="rlabel" x="870" y="820" font-size="10">열대사바나</text>
          <text class="rlabel" x="128" y="880" font-size="10">열대해양</text>
        </g>

        <!-- ── RIVERS ── -->
        <g id="L-rivers" class="layer" fill="none" stroke="#2E7A8C" stroke-linecap="round" opacity=".85">
