# ============================================================================
# rfipconfig-fe.yaml — 프런트엔드(Angular/Node.js) Shipwright Build 정의
#
# 백엔드(rfipconfig-be)와 동일한 파이프라인 구조를 사용합니다:
#   - 같은 네임스페이스 (openshift-builds)
#   - 같은 ServiceAccount (pipeline)
#   - 같은 ClusterBuildStrategy (s2i)
#   - 같은 pushSecret (pipeline-push-secret)
#   - 같은 SSL_CERT_FILE 패턴 (사내 quay CA 신뢰)
#
# ⚠️ <꺾쇠괄호> 로 표시된 값은 실제 환경 값으로 반드시 교체해야 합니다.
#    교체하지 않으면 빌드가 실패합니다.
# ============================================================================
apiVersion: shipwright.io/v1beta1
kind: Build
metadata:
  name: rfipconfig-fe-s2i-build
  namespace: openshift-builds
spec:
  env:
    # --- Node.js s2i 빌더 공통 설정 ---
    # Angular 프로덕션 빌드를 실행할 npm 스크립트.
    # package.json의 scripts에 정의된 이름과 일치해야 함 (예: "build")
    - name: NPM_RUN
      value: '<package.json의 빌드 스크립트 이름>'   # 예: build 또는 build:prod

    # 앱이 리슨할 포트. 컨테이너/서비스 설정과 일치시킬 것
    - name: PORT
      value: '<포트 번호>'                            # 예: "8080"

    # --- 백엔드와 동일한 사내 CA 신뢰 설정 (quay pull용) ---
    # s2i ClusterBuildStrategy가 hobbylobby.corp configMap을
    # 이 경로에 마운트하므로 값 자체는 그대로 사용
    - name: SSL_CERT_FILE
      value: /etc/pki/ca-trust/extracted/trust-manager/ca-certs.pem

    # --- (선택) 빌드 시 API 엔드포인트 주입이 필요한 경우 ---
    # Angular는 보통 environment.ts로 관리하므로 필요 없을 수 있음.
    # 필요 없으면 이 항목은 삭제
    # - name: API_URL
    #   value: '<백엔드 API 주소>'                    # 예: https://rfipconfig-be.<도메인>

  source:
    type: Git
    git:
      # 프런트엔드 소스 저장소 (SSH 형식, 백엔드와 동일한 패턴)
      url: '<프런트엔드 Git 저장소 SSH 주소>'          # 예: git@hlgithub.hobbylobby.corp:Warehouse/rfipconfig-frontend.git

      # git clone용 SSH 키 시크릿.
      # ⚠️ 저장소가 다르면 deploy key도 다르므로 새 시크릿 생성 필요:
      #   oc create secret generic <시크릿이름> \
      #     --from-file=ssh-privatekey=<개인키 경로> \
      #     --type=kubernetes.io/ssh-auth -n openshift-builds
      cloneSecret: '<SSH 키 시크릿 이름>'              # 예: github-repo-ssh-key-rfipconfig-fe

      revision: '<브랜치 이름>'                        # 예: master 또는 main
      depth: 1

    # 저장소 루트에 package.json이 있으면 이 줄 삭제,
    # 하위 디렉터리에 있으면 해당 경로 지정
    contextDir: '<프런트엔드 앱 디렉터리>'             # 예: Rfipconfig.Web 또는 frontend

  strategy:
    # 백엔드와 동일한 s2i 전략 재사용 — 별도 수정 불필요
    name: s2i
    kind: ClusterBuildStrategy

  paramValues:
    # Node.js 빌더 이미지.
    # ⚠️ quay.hobbylobby.corp에 실제 존재하는 이미지·태그 확인 필요:
    #   podman search quay.hobbylobby.corp/hl-images/ 또는 Quay UI에서 확인
    - name: builder-image
      value: '<Node.js 빌더 이미지 전체 경로>'         # 예: quay.hobbylobby.corp/hl-images/hl-nodejs:20-rhel9-latest

  output:
    # 백엔드와 동일하게 내부 레지스트리의 openshift-builds 네임스페이스 사용.
    # 이미지 이름만 fe로 변경. 다른 네임스페이스를 쓰려면
    # 해당 NS 존재 확인 + system:image-builder 권한 부여 필요 (README 2-3 참고)
    image: image-registry.openshift-image-registry.svc:5000/openshift-builds/rfipconfig-fe:latest

    # 백엔드에서 만든 시크릿 그대로 재사용 (같은 네임스페이스이므로 추가 작업 불필요)
    pushSecret: pipeline-push-secret
---
# ============================================================================
# BuildRun — 빌드 실행 트리거 (매번 oc create로 실행)
# ============================================================================
apiVersion: shipwright.io/v1beta1
kind: BuildRun
metadata:
  # generateName 사용: 매번 고유 이름 자동 생성
  # ⚠️ oc apply가 아닌 oc create -f 로 실행할 것
  generateName: rfipconfig-fe-s2i-build-
  namespace: openshift-builds
spec:
  build:
    name: rfipconfig-fe-s2i-build
  serviceAccount: pipeline
