<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>원정도 편집기 — 재의 상흔</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600&family=Noto+Sans+KR:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root{
  --plate:#0A1F1E;--plate2:#0F2C29;--plate3:#143733;--line:#2A4A44;
  --brass:#CBA135;--brass2:#8C6F2A;--brass3:#5A4A22;
  --bone:#E9E1CB;--dim:#93A099;--sea:#0A2A33;--ember:#E4622F;
  --serif:'Noto Serif KR',Georgia,serif;--sans:'Noto Sans KR',system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,monospace;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--plate);color:var(--bone);font-family:var(--sans);font-weight:300;
  display:flex;flex-direction:column;overflow:hidden;font-size:13px}

/* ── top bar ── */
.top{display:flex;align-items:center;gap:14px;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--plate2);flex-wrap:wrap}
.brand{font-family:var(--serif);font-weight:600;font-size:16px;letter-spacing:-.01em;white-space:nowrap}
.brand span{color:var(--ember)}
.wname{background:transparent;border:1px solid var(--brass3);color:var(--bone);font-family:var(--sans);
  padding:6px 10px;font-size:12px;width:190px;border-radius:1px}
.spacer{flex:1}
.btn{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
  background:transparent;color:var(--brass2);border:1px solid var(--brass3);padding:7px 11px;
  cursor:pointer;border-radius:1px;transition:.15s;white-space:nowrap}
.btn:hover{color:var(--bone);border-color:var(--brass2)}
.btn.primary{background:var(--brass);color:#0A1F1E;border-color:var(--brass);font-weight:600}
.btn[aria-pressed="true"]{background:var(--brass);color:#0A1F1E;border-color:var(--brass);font-weight:600}
.btn:focus-visible{outline:2px solid var(--ember);outline-offset:2px}

/* ── layout ── */
.body{flex:1;display:grid;grid-template-columns:236px minmax(0,1fr) 320px;min-height:0}
.rail,.side{background:var(--plate2);overflow-y:auto;display:flex;flex-direction:column}
.rail{border-right:1px solid var(--line)}
.side{border-left:1px solid var(--line)}
.stage{position:relative;background:var(--sea);min-width:0}
svg#cv{display:block;width:100%;height:100%;touch-action:none;cursor:crosshair}
svg#cv.tool-select{cursor:default}

/* ── panels ── */
.ph{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;color:var(--brass2);text-transform:uppercase;
  padding:12px 14px 8px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--plate2);z-index:2}
.pad{padding:12px 14px}
.tabs{display:flex;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--plate2);z-index:3}
.tab{flex:1;padding:11px 4px;text-align:center;font-family:var(--mono);font-size:10px;letter-spacing:.1em;
  color:var(--brass2);cursor:pointer;border-bottom:2px solid transparent;text-transform:uppercase}
.tab[aria-selected="true"]{color:var(--bone);border-bottom-color:var(--brass)}

/* ── tool palette ── */
.tools{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:12px 14px}
.tools .btn{padding:9px 6px;font-size:10px;text-align:center}
.toggles{display:flex;flex-direction:column;gap:5px;padding:0 14px 14px}
.tg{display:flex;align-items:center;gap:9px;font-size:12px;color:var(--dim);cursor:pointer;padding:3px 0}
.tg input{accent-color:var(--brass);width:14px;height:14px}
.tg:hover{color:var(--bone)}

/* ── object list ── */
.search{width:100%;background:var(--plate);border:1px solid var(--brass3);color:var(--bone);padding:7px 9px;font-size:12px;font-family:var(--sans)}
.olist{padding:0 0 20px}
.oitem{display:flex;align-items:center;gap:9px;padding:8px 14px;cursor:pointer;border-left:2px solid transparent;font-size:12px}
.oitem:hover{background:var(--plate3)}
.oitem.sel{background:var(--plate3);border-left-color:var(--brass)}
.dot{width:9px;height:9px;flex:0 0 9px;border-radius:50%;border:1px solid rgba(0,0,0,.4)}
.dot.sq{border-radius:1px;transform:rotate(45deg)}
.oitem .meta{margin-left:auto;font-family:var(--mono);font-size:9px;color:var(--brass2);letter-spacing:.08em}

/* ── forms ── */
.field{margin-bottom:11px}
.field label{display:block;font-family:var(--mono);font-size:9.5px;letter-spacing:.13em;color:var(--brass2);
  text-transform:uppercase;margin-bottom:4px}
.field input,.field select,.field textarea{width:100%;background:var(--plate);border:1px solid var(--brass3);
  color:var(--bone);padding:7px 9px;font-size:12px;font-family:var(--sans);border-radius:1px}
.field textarea{min-height:56px;resize:vertical;line-height:1.55}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--brass)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.hint{font-size:11.5px;color:var(--dim);line-height:1.6}
.chip{display:inline-block;font-family:var(--mono);font-size:9px;letter-spacing:.08em;border:1px solid var(--brass3);
  color:var(--dim);padding:3px 7px;margin:0 4px 4px 0}
.danger{color:#D8705E;border-color:#5C3129}
.danger:hover{color:#F09883;border-color:#8A4A3C}

/* ── faction rows ── */
.frow{display:grid;grid-template-columns:26px 1fr 30px;gap:7px;align-items:center;margin-bottom:7px}
.frow input[type=color]{width:26px;height:26px;padding:0;border:1px solid var(--brass3);background:none;cursor:pointer}
.frow input[type=text]{background:var(--plate);border:1px solid var(--brass3);color:var(--bone);padding:6px 8px;font-size:12px;width:100%}
.xbtn{background:none;border:1px solid var(--brass3);color:#B0685C;cursor:pointer;font-size:14px;line-height:1;padding:4px 0}

/* ── relation rows ── */
.rrow{display:grid;grid-template-columns:1fr 62px;gap:8px;align-items:center;margin-bottom:6px}
.rrow .nm{font-size:12px;display:flex;align-items:center;gap:7px}
.rrow input{background:var(--plate);border:1px solid var(--brass3);color:var(--bone);padding:5px 6px;
  font-size:11px;font-family:var(--mono);text-align:center;width:100%}
.rwhy{width:100%;background:var(--plate);border:1px solid var(--brass3);color:var(--dim);padding:5px 7px;
  font-size:10.5px;font-family:var(--sans);margin:-2px 0 9px}

/* ── canvas overlay ── */
.hud{position:absolute;left:12px;bottom:12px;display:flex;gap:8px;align-items:center;
  font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--brass2);
  background:rgba(10,31,30,.82);border:1px solid var(--line);padding:6px 10px;pointer-events:none}
.toast{position:absolute;right:14px;top:14px;background:var(--plate2);border:1px solid var(--brass);
  color:var(--bone);padding:9px 14px;font-size:12px;opacity:0;transition:.25s;pointer-events:none}
.toast.on{opacity:1}

/* svg element classes */
.pt{cursor:pointer}
.pt.hide{display:none}
.plabel{font-family:var(--sans);font-size:12px;fill:var(--bone);pointer-events:none;paint-order:stroke;
  stroke:#0A1F1E;stroke-width:3px;stroke-linejoin:round}
.psub{font-family:var(--mono);font-size:8.5px;fill:#9AA79F;pointer-events:none;paint-order:stroke;
  stroke:#0A1F1E;stroke-width:3px}
.selring{fill:none;stroke:var(--brass);stroke-width:2;stroke-dasharray:4 4}
.edge{stroke-linecap:round}
.edge.hit{stroke:transparent;stroke-width:14;cursor:pointer}

@media (max-width:1100px){
  .body{grid-template-columns:1fr}
  .rail,.side{max-height:230px}
  .stage{min-height:52vh}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<div class="top">
  <div class="brand">원정도 <span>편집기</span></div>
  <input class="wname" id="wname" value="재의 상흔 — 대륙" aria-label="세계 이름">
  <div class="spacer"></div>
  <button class="btn" id="btnPreset">기본 세계</button>
  <button class="btn" id="btnClear">비우기</button>
  <button class="btn" id="btnImport">불러오기</button>
  <button class="btn primary" id="btnExport">JSON 저장</button>
  <button class="btn" id="btnSvg">SVG 저장</button>
  <input type="file" id="fileIn" accept=".json,application/json" hidden>
</div>

<div class="body">

  <!-- LEFT RAIL -->
  <div class="rail">
    <div class="ph">도구</div>
    <div class="tools" id="tools">
      <button class="btn" data-tool="select" aria-pressed="true">선택 · 이동</button>
      <button class="btn" data-tool="region">지역 추가</button>
      <button class="btn" data-tool="stop">원정 노드</button>
      <button class="btn" data-tool="link">연결</button>
      <button class="btn danger" data-tool="erase">삭제</button>
      <button class="btn" id="btnFit">화면 맞춤</button>
    </div>

    <div class="ph">표시</div>
    <div class="toggles" id="vis">
      <label class="tg"><input type="checkbox" data-v="region" checked> 지역</label>
      <label class="tg"><input type="checkbox" data-v="stop" checked> 원정 노드</label>
      <label class="tg"><input type="checkbox" data-v="edge" checked> 연결선</label>
      <label class="tg"><input type="checkbox" data-v="rival" checked> 라이벌 전선</label>
      <label class="tg"><input type="checkbox" data-v="label" checked> 이름표</label>
      <label class="tg"><input type="checkbox" data-v="grid" checked> 격자</label>
    </div>

    <div class="ph">목록</div>
    <div class="pad" style="padding-bottom:8px"><input class="search" id="q" placeholder="이름 검색"></div>
    <div class="olist" id="olist"></div>
  </div>

  <!-- CANVAS -->
  <div class="stage">
    <svg id="cv" viewBox="0 0 1440 1000">
      <defs>
        <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M60 0H0V60" fill="none" stroke="#123A44" stroke-width="1"/>
        </pattern>
        <pattern id="grid5" width="300" height="300" patternUnits="userSpaceOnUse">
          <path d="M300 0H0V300" fill="none" stroke="#1B4E5C" stroke-width="1.2"/>
        </pattern>
      </defs>
      <rect id="bg" x="-4000" y="-4000" width="12000" height="12000" fill="#082129"/>
      <g id="gGrid"><rect x="-4000" y="-4000" width="12000" height="12000" fill="url(#grid)"/>
        <rect x="-4000" y="-4000" width="12000" height="12000" fill="url(#grid5)"/></g>
      <g id="gRival"></g>
      <g id="gEdge"></g>
      <g id="gPt"></g>
      <g id="gSel"></g>
    </svg>
    <div class="hud"><span id="hudTool">선택</span><span id="hudPos">0, 0</span><span id="hudCount"></span></div>
    <div class="toast" id="toast"></div>
  </div>

  <!-- RIGHT SIDE -->
  <div class="side">
    <div class="tabs" id="tabs">
      <div class="tab" data-tab="prop" aria-selected="true">속성</div>
      <div class="tab" data-tab="fac" aria-selected="false">세력</div>
      <div class="tab" data-tab="rel" aria-selected="false">관계</div>
    </div>
    <div id="panProp" class="pad"></div>
    <div id="panFac" class="pad" hidden></div>
    <div id="panRel" class="pad" hidden></div>
  </div>
</div>

<script>
/* ═══════════ 상수 ═══════════ */
const CLIMATE={
 '지중해성':'#C7A94B','온대고원':'#6E8FA8','고산냉대':'#8FA9C4','고온건조':'#E0A94E',
 '반건조고원':'#B98C63','아한대':'#9FC6D6','온대몬순':'#5FA08C','열대사바나':'#C6C05A',
 '열대해양':'#4FBFA0','기후없음':'#E4622F','미지정':'#5E6E68'};
