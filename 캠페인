    <div id="mismatch"></div>
    <div class="field"><label>메모</label><textarea id="f_notes">${esc(p.notes)}</textarea></div>`;
  const stopFields=`
    <div class="field"><label>노드 유형</label><select id="f_ntype">${opt(Object.keys(NTYPE),p.ntype)}</select></div>
    <div class="row2">
      <div class="field"><label>층 (Layer)</label><input id="f_layer" type="number" min="0" value="${p.layer}"></div>
      <div class="field"><label>계절</label><select id="f_season">${opt(SEASON,p.season)}</select></div>
    </div>
    <div class="field"><label>지형</label><select id="f_terrain">${opt(TERRAIN,p.terrain)}</select></div>
    <div class="field"><label>전장 규칙 / 이벤트</label><textarea id="f_event">${esc(p.event)}</textarea></div>`;
  el.innerHTML=`<div class="ph" style="margin:-12px -14px 12px;position:static">${p.kind==='region'?'지역':'원정 노드'}</div>`
    +common+(p.kind==='region'?regionFields:stopFields)
    +`<div style="margin-top:14px;display:flex;gap:7px">
        <button class="btn" id="f_dup">복제</button>
        <button class="btn danger" id="f_del">삭제</button></div>`;

  const bind=(id,key,num)=>{const n=$('#'+id);if(!n)return;
    n.oninput=ev=>{p[key]=num?(+ev.target.value||0):ev.target.value;
      if(key==='blood'||key==='creed'||key==='live'||key==='faction')checkMismatch(p);
      render();renderList();};};
  bind('f_name','name');bind('f_x','x',1);bind('f_y','y',1);bind('f_size','size',1);
  ['climate','terrain','season','faction','blood','creed','live','notes','ntype','event'].forEach(k=>bind('f_'+k,k));
  bind('f_layer','layer',1);
  if(p.kind==='region')checkMismatch(p);
  $('#f_del').onclick=()=>{W.points=W.points.filter(x=>x.id!==p.id);
    W.edges=W.edges.filter(e=>e.a!==p.id&&e.b!==p.id);sel=null;toast('삭제됨');refresh();};
  $('#f_dup').onclick=()=>{const c={...p,id:nid(p.kind[0]),x:p.x+40,y:p.y+40,name:p.name+' 사본'};
    W.points.push(c);sel={t:'point',id:c.id};refresh();};
}
function checkMismatch(p){
  const box=$('#mismatch'); if(!box)return;
  const f=fac(p.faction);
  if(!f){box.innerHTML='';return;}
  const bad=[];
  if(f.blood!==p.blood&&f.blood!=='—'&&p.blood!=='—'&&f.blood!=='무적(無籍)')bad.push('혈통');
  if(f.creed!==p.creed&&f.creed!=='—'&&p.creed!=='—')bad.push('신앙');
  if(f.live!==p.live&&f.live!=='—'&&p.live!=='—')bad.push('생계');
  box.innerHTML=bad.length
    ? `<div class="hint" style="border:1px solid #6B3A2C;padding:9px;margin-bottom:11px;color:#E0A08C">
        <b>정체성 불일치 — ${bad.join(' · ')}</b><br>세수 감소 · 반란 확률 상승 · 적 세력 선동 대상</div>`
    : `<div class="hint" style="border:1px solid #2F5A46;padding:9px;margin-bottom:11px;color:#8FC7AC">정체성 일치 — 안정</div>`;
}

/* ═══════════ 세력 패널 ═══════════ */
function renderFac(){
  $('#panFac').innerHTML=W.factions.map(f=>`
    <div class="frow">
      <input type="color" value="${f.color}" data-f="${f.id}" data-k="color">
      <input type="text" value="${esc(f.name)}" data-f="${f.id}" data-k="name">
      <button class="xbtn" data-del="${f.id}">×</button>
    </div>
    <details style="margin:-3px 0 12px 33px">
      <summary style="cursor:pointer;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--brass2)">상세</summary>
      <div style="padding-top:9px">
        <div class="field"><label>혈통</label><select data-f="${f.id}" data-k="blood">${BLOOD.map(o=>`<option ${o===f.blood?'selected':''}>${o}</option>`).join('')}</select></div>
        <div class="field"><label>신앙</label><select data-f="${f.id}" data-k="creed">${CREED.map(o=>`<option ${o===f.creed?'selected':''}>${o}</option>`).join('')}</select></div>
        <div class="field"><label>생계</label><select data-f="${f.id}" data-k="live">${LIVE.map(o=>`<option ${o===f.live?'selected':''}>${o}</option>`).join('')}</select></div>
        <div class="field"><label>라이벌</label><select data-f="${f.id}" data-k="rival">
          <option value="">없음</option>${W.factions.filter(o=>o.id!==f.id).map(o=>`<option value="${o.id}" ${o.id===f.rival?'selected':''}>${esc(o.name)}</option>`).join('')}</select></div>
        <div class="field"><label>마계 채무 상승 속도 (1~5)</label><input type="number" min="0" max="5" value="${f.debt??1}" data-f="${f.id}" data-k="debt"></div>
        <div class="field"><label>목표</label><textarea data-f="${f.id}" data-k="goal">${esc(f.goal||'')}</textarea></div>
      </div>
    </details>`).join('')
    +`<button class="btn" id="facAdd" style="width:100%;margin-top:6px">세력 추가</button>`;

  $$('#panFac [data-f]').forEach(n=>n.oninput=ev=>{
    const f=fac(n.dataset.f);if(!f)return;
    f[n.dataset.k]=n.dataset.k==='debt'?+ev.target.value:ev.target.value;
    render();renderList();if(n.dataset.k!=='name'&&n.dataset.k!=='color')renderRel();});
  $$('#panFac [data-del]').forEach(b=>b.onclick=()=>{
    const id=b.dataset.del;
    W.factions=W.factions.filter(f=>f.id!==id);
    W.points.forEach(p=>{if(p.faction===id)p.faction='';});
    W.factions.forEach(f=>{if(f.rival===id)f.rival='';});
    Object.keys(W.relations).forEach(k=>{if(k.split('|').includes(id))delete W.relations[k];});
    refresh();});
  $('#facAdd').onclick=()=>{
    const id='f'+(uid++);
    W.factions.push({id,name:'새 세력',color:'#CBA135',blood:'—',creed:'—',live:'—',rival:'',goal:'',debt:1});
    refresh();};
}

/* ═══════════ 관계 패널 ═══════════ */
let relFocus=null;
function renderRel(){
  const el=$('#panRel');
  if(W.factions.length<2){el.innerHTML='<div class="hint">세력을 2개 이상 만들면 관계를 편집할 수 있습니다.</div>';return;}
  if(!relFocus||!fac(relFocus))relFocus=W.factions[0].id;
  const F=fac(relFocus);
  el.innerHTML=`<div class="field"><label>기준 세력</label>
      <select id="relSel">${W.factions.map(f=>`<option value="${f.id}" ${f.id===relFocus?'selected':''}>${esc(f.name)}</option>`).join('')}</select></div>
    <div class="hint" style="margin-bottom:12px">−100 적대 · 0 중립 · +100 우호. 값과 근거를 직접 수정할 수 있습니다.</div>`
    +W.factions.filter(f=>f.id!==relFocus).map(f=>{
      const k=rkey(relFocus,f.id),r=W.relations[k]||{v:0,why:''};
      return `<div class="rrow">
        <span class="nm"><span class="dot" style="background:${f.color}"></span>${esc(f.name)}</span>
        <input type="number" min="-100" max="100" value="${r.v}" data-k="${k}" data-p="v" style="color:${relColor(r.v)}">
      </div>
      <input class="rwhy" placeholder="근거" value="${esc(r.why)}" data-k="${k}" data-p="why">`;
    }).join('')
    +`<div class="hint" style="margin-top:14px;border-top:1px solid var(--line);padding-top:12px">
       <b style="color:var(--bone)">${esc(F.name)}</b> — ${esc(F.goal||'목표 미지정')}<br><br>
       ${F.id==='aby'?'마계는 우호도 대신 <b>채무 게이지</b>로 상호작용합니다. 위 값은 표시용 고정치입니다.':'마계 채무 상승 속도: <b>'+('★'.repeat(F.debt??1)||'—')+'</b>'}</div>`;
  $('#relSel').onchange=ev=>{relFocus=ev.target.value;renderRel();};
  $$('#panRel [data-k]').forEach(n=>n.oninput=ev=>{
    const k=n.dataset.k;W.relations[k]=W.relations[k]||{v:0,why:''};
    if(n.dataset.p==='v'){W.relations[k].v=Math.max(-100,Math.min(100,+ev.target.value||0));
      n.style.color=relColor(W.relations[k].v);}
    else W.relations[k].why=ev.target.value;});
}
function relColor(v){
  if(v>0)return `rgb(${58+v/100*21|0},${90+v/100*73|0},${80+v/100*47|0})`;
  if(v<0)return `rgb(${88+(-v)/100*104|0},${76-(-v)/100*4|0},${72-(-v)/100*9|0})`;
  return '#8C9691';
}

/* ═══════════ 캔버스 조작 ═══════════ */
function toWorld(ev){
  const r=cv.getBoundingClientRect();
  return {x:view.x+(ev.clientX-r.left)/r.width*view.w, y:view.y+(ev.clientY-r.top)/r.height*view.h};
}
let drag=null;
function onPointDown(ev,p){
  ev.stopPropagation();
  if(tool==='erase'){
    W.points=W.points.filter(x=>x.id!==p.id);
    W.edges=W.edges.filter(e=>e.a!==p.id&&e.b!==p.id);
    if(sel&&sel.id===p.id)sel=null;
    toast('삭제됨');refresh();return;
  }
  if(tool==='link'){
    if(!linkFrom){linkFrom=p.id;toast('연결 시작 — 대상을 누르세요');}
    else if(linkFrom!==p.id){
      const dup=W.edges.some(e=>(e.a===linkFrom&&e.b===p.id)||(e.b===linkFrom&&e.a===p.id));
      if(!dup){
        const A=pt(linkFrom);
        const type=(A.kind==='stop'&&p.kind==='stop')?'원정로':'육로';
        W.edges.push({id:nid('e'),a:linkFrom,b:p.id,type});toast('연결 생성');
      }else toast('이미 연결되어 있습니다');
      linkFrom=null;
    }else linkFrom=null;
    refresh();return;
  }
  sel={t:'point',id:p.id};
  const s=toWorld(ev);
  drag={id:p.id,dx:p.x-s.x,dy:p.y-s.y,moved:false};
  cv.setPointerCapture(ev.pointerId);
  refresh();
}
cv.addEventListener('pointerdown',ev=>{
  if(ev.target.closest('.pt')||ev.target.closest('.edge.hit'))return;
  const w=toWorld(ev);
  if(tool==='region'||tool==='stop'){
    const p=tool==='region'
      ?{id:nid('r'),kind:'region',name:'새 지역',x:w.x,y:w.y,size:15,climate:'미지정',terrain:'평야',
        faction:'',blood:'—',creed:'—',live:'—',season:'맑음',notes:'',ntype:'',layer:0,event:''}
      :{id:nid('s'),kind:'stop',name:'새 노드',x:w.x,y:w.y,size:12,climate:'미지정',terrain:'평야',
        faction:'',blood:'—',creed:'—',live:'—',season:'맑음',notes:'',ntype:'교전',layer:0,event:''};
    W.points.push(p);sel={t:'point',id:p.id};refresh();return;
  }
  sel=null;linkFrom=null;
  drag={pan:true,sx:ev.clientX,sy:ev.clientY,vx:view.x,vy:view.y};
  cv.setPointerCapture(ev.pointerId);
  refresh();
});
cv.addEventListener('pointermove',ev=>{
  const w=toWorld(ev);
  $('#hudPos').textContent=`${Math.round(w.x)}, ${Math.round(w.y)}`;
  if(!drag)return;
  if(drag.pan){
    const r=cv.getBoundingClientRect();
    view.x=drag.vx-(ev.clientX-drag.sx)/r.width*view.w;
    view.y=drag.vy-(ev.clientY-drag.sy)/r.height*view.h;
    render();
  }else{
    const p=pt(drag.id);if(!p)return;
    p.x=w.x+drag.dx;p.y=w.y+drag.dy;drag.moved=true;render();
  }
});
cv.addEventListener('pointerup',()=>{
  if(drag&&!drag.pan&&drag.moved)renderProp();
  drag=null;});
cv.addEventListener('wheel',ev=>{
  ev.preventDefault();
  const w=toWorld(ev),k=ev.deltaY>0?1.12:1/1.12;
  const nw=Math.max(160,Math.min(6000,view.w*k)),nh=nw*(view.h/view.w);
  view.x=w.x-(w.x-view.x)*(nw/view.w);
  view.y=w.y-(w.y-view.y)*(nh/view.h);
  view.w=nw;view.h=nh;render();
},{passive:false});
addEventListener('keydown',ev=>{
  if(/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName))return;
  if(ev.key==='Delete'||ev.key==='Backspace'){
    if(sel&&sel.t==='point'){W.points=W.points.filter(x=>x.id!==sel.id);
      W.edges=W.edges.filter(e=>e.a!==sel.id&&e.b!==sel.id);sel=null;refresh();}
    else if(sel&&sel.t==='edge'){W.edges=W.edges.filter(x=>x.id!==sel.id);sel=null;refresh();}
  }
  if(ev.key==='Escape'){sel=null;linkFrom=null;refresh();}
  const keys={'1':'select','2':'region','3':'stop','4':'link','5':'erase'};
  if(keys[ev.key])setTool(keys[ev.key]);
});
function fit(){
  if(!W.points.length){view={x:0,y:0,w:1440,h:1000};return render();}
  const xs=W.points.map(p=>p.x),ys=W.points.map(p=>p.y);
  const pad=140,minX=Math.min(...xs)-pad,maxX=Math.max(...xs)+pad,
        minY=Math.min(...ys)-pad,maxY=Math.max(...ys)+pad;
  const r=cv.getBoundingClientRect(),ar=r.width/r.height||1.4;
  let w=maxX-minX,h=maxY-minY;
  if(w/h<ar)w=h*ar;else h=w/ar;
  view={x:(minX+maxX)/2-w/2,y:(minY+maxY)/2-h/2,w,h};
  render();
}

/* ═══════════ 툴 · 탭 · 표시 ═══════════ */
function setTool(t){tool=t;
  $$('#tools .btn[data-tool]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tool===t)));
  cv.classList.toggle('tool-select',t==='select');
  linkFrom=null;
  $('#hudTool').textContent={select:'선택',region:'지역 추가',stop:'노드 추가',link:'연결',erase:'삭제'}[t];
  render();}
$$('#tools .btn[data-tool]').forEach(b=>b.onclick=()=>setTool(b.dataset.tool));
$('#btnFit').onclick=fit;
$$('#vis input').forEach(i=>i.onchange=()=>{vis[i.dataset.v]=i.checked;render();});
$$('.tab').forEach(t=>t.onclick=()=>{
  $$('.tab').forEach(x=>x.setAttribute('aria-selected',String(x===t)));
  $('#panProp').hidden=t.dataset.tab!=='prop';
  $('#panFac').hidden=t.dataset.tab!=='fac';
  $('#panRel').hidden=t.dataset.tab!=='rel';
  if(t.dataset.tab==='fac')renderFac();
  if(t.dataset.tab==='rel')renderRel();});
$('#q').oninput=renderList;
$('#wname').oninput=ev=>W.meta.name=ev.target.value;

/* ═══════════ 파일 ═══════════ */
function dl(name,text,type){
  const b=new Blob([text],{type}),u=URL.createObjectURL(b),a=document.createElement('a');
  a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1500);}
$('#btnExport').onclick=()=>{
  dl((W.meta.name||'world').replace(/\s+/g,'-')+'.json',JSON.stringify(W,null,2),'application/json');
  toast('JSON 저장됨');};
$('#btnImport').onclick=()=>$('#fileIn').click();
$('#fileIn').onchange=ev=>{
  const f=ev.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{try{
    const d=JSON.parse(r.result);
    if(!d.points||!d.factions)throw 0;
    W=d;W.relations=W.relations||{};W.meta=W.meta||{name:'불러온 세계'};
    uid=Date.now()%100000;sel=null;relFocus=null;
    $('#wname').value=W.meta.name||'';
    fit();refresh();toast('불러왔습니다');
  }catch(e){toast('파일을 읽을 수 없습니다');}};
  r.readAsText(f);ev.target.value='';};
$('#btnSvg').onclick=()=>{
  const c=cv.cloneNode(true);
  c.querySelectorAll('.edge.hit').forEach(n=>n.remove());
  c.querySelector('#gSel').innerHTML='';
  c.setAttribute('xmlns',SVGNS);
  c.setAttribute('width',Math.round(view.w));c.setAttribute('height',Math.round(view.h));
  const st=document.createElementNS(SVGNS,'style');
  st.textContent=`.plabel{font-family:'Noto Sans KR',sans-serif;font-size:12px;fill:#E9E1CB;paint-order:stroke;stroke:#0A1F1E;stroke-width:3px}
.psub{font-family:monospace;font-size:8.5px;fill:#9AA79F;paint-order:stroke;stroke:#0A1F1E;stroke-width:3px}`;
  c.insertBefore(st,c.firstChild);
  dl((W.meta.name||'map').replace(/\s+/g,'-')+'.svg',new XMLSerializer().serializeToString(c),'image/svg+xml');
  toast('SVG 저장됨');};
$('#btnPreset').onclick=()=>{W=presetWorld();sel=null;relFocus=null;
  $('#wname').value=W.meta.name;fit();refresh();toast('기본 세계를 불러왔습니다');};
$('#btnClear').onclick=()=>{
  if(!confirm('현재 작업을 모두 비웁니다. 저장하지 않은 내용은 사라집니다.'))return;
  W=blankWorld();sel=null;relFocus=null;$('#wname').value=W.meta.name;
  view={x:0,y:0,w:1440,h:1000};refresh();};

let tt;
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');
  clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),1600);}

function refresh(){render();renderList();renderProp();
  if(!$('#panFac').hidden)renderFac();
  if(!$('#panRel').hidden)renderRel();}

/* ═══════════ 시작 ═══════════ */
W=presetWorld();
$('#wname').value=W.meta.name;
setTool('select');
requestAnimationFrame(()=>{fit();refresh();});
</script>
</body>
</html>
