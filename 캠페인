const cv=$('#cv'),gPt=$('#gPt'),gEdge=$('#gEdge'),gSel=$('#gSel'),gRival=$('#gRival'),gGrid=$('#gGrid');

function render(){
  cv.setAttribute('viewBox',`${view.x} ${view.y} ${view.w} ${view.h}`);
  gGrid.style.display=vis.grid?'':'none';
  gEdge.innerHTML='';gPt.innerHTML='';gSel.innerHTML='';gRival.innerHTML='';

  // rival front lines
  if(vis.rival){
    const seen=new Set();
    W.factions.forEach(f=>{
      if(!f.rival||f.rival==='all')return;
      const k=[f.id,f.rival].sort().join('|'); if(seen.has(k))return; seen.add(k);
      const A=W.points.find(p=>p.kind==='region'&&p.faction===f.id);
      const B=W.points.find(p=>p.kind==='region'&&p.faction===f.rival);
      if(!A||!B)return;
      gRival.appendChild(mk('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,stroke:'#C0503F',
        'stroke-width':2,'stroke-dasharray':'3 7','stroke-opacity':.6}));
    });
  }

  // edges
  if(vis.edge)W.edges.forEach(e=>{
    const A=pt(e.a),B=pt(e.b); if(!A||!B)return;
    if(!vis[A.kind]||!vis[B.kind])return;
    const c=EDGETYPE[e.type]||'#8C6F2A';
    gEdge.appendChild(mk('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,stroke:c,'stroke-width':e.type==='원정로'?2.6:1.8,
      'stroke-opacity':.72,'stroke-dasharray':e.type==='해로'?'8 6':e.type==='균열로'?'2 6':'',class:'edge'}));
    const hit=mk('line',{x1:A.x,y1:A.y,x2:B.x,y2:B.y,class:'edge hit'});
    hit.addEventListener('click',ev=>{ev.stopPropagation();
      if(tool==='erase'){W.edges=W.edges.filter(x=>x.id!==e.id);toast('연결 삭제');refresh();}
      else{sel={t:'edge',id:e.id};refresh();}});
    gEdge.appendChild(hit);
  });

  // points
  W.points.forEach(p=>{
    if(!vis[p.kind])return;
    const g=mk('g',{class:'pt'});
    if(p.kind==='region'){
      const c=CLIMATE[p.climate]||CLIMATE['미지정'], fc=fac(p.faction);
      g.appendChild(mk('circle',{cx:p.x,cy:p.y,r:p.size+7,fill:'none',
        stroke:fc?fc.color:'#5A4A22','stroke-width':1.4,'stroke-opacity':.75}));
      g.appendChild(mk('circle',{cx:p.x,cy:p.y,r:p.size,fill:c,stroke:'#0A1F1E','stroke-width':2}));
    }else{
      const c=NTYPE[p.ntype]||'#CBA135', s=p.size;
      g.appendChild(mk('rect',{x:p.x-s,y:p.y-s,width:s*2,height:s*2,fill:c,stroke:'#0A1F1E','stroke-width':2,
        transform:`rotate(45 ${p.x} ${p.y})`}));
      if(p.ntype==='관문'){
        g.appendChild(mk('rect',{x:p.x-s-6,y:p.y-s-6,width:(s+6)*2,height:(s+6)*2,fill:'none',
          stroke:c,'stroke-width':1.4,'stroke-opacity':.7,transform:`rotate(45 ${p.x} ${p.y})`}));
      }
    }
    if(vis.label){
      const t=mk('text',{x:p.x,y:p.y+p.size+18,class:'plabel','text-anchor':'middle'});
      t.textContent=p.name;g.appendChild(t);
      const sub=p.kind==='region'
        ? [p.climate,p.terrain].filter(v=>v&&v!=='미지정').join(' · ')
        : [p.ntype,'L'+p.layer,p.season].filter(Boolean).join(' · ');
      if(sub){const s2=mk('text',{x:p.x,y:p.y+p.size+31,class:'psub','text-anchor':'middle'});
        s2.textContent=sub;g.appendChild(s2);}
    }
    g.addEventListener('pointerdown',ev=>onPointDown(ev,p));
    gPt.appendChild(g);
  });

  // selection ring
  if(sel&&sel.t==='point'){const p=pt(sel.id);
    if(p)gSel.appendChild(mk('circle',{cx:p.x,cy:p.y,r:p.size+14,class:'selring'}));}
  if(linkFrom){const p=pt(linkFrom);
    if(p)gSel.appendChild(mk('circle',{cx:p.x,cy:p.y,r:p.size+18,fill:'none',stroke:'#E4622F','stroke-width':2}));}

  $('#hudCount').textContent=`지역 ${W.points.filter(p=>p.kind==='region').length} · 노드 ${W.points.filter(p=>p.kind==='stop').length} · 연결 ${W.edges.length}`;
}

