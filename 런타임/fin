      cloneSecret: github-repo-ssh-key-rfipconfig-be
      revision: master
      depth: 1
    contextDir: runtime
  strategy:
    name: buildah-hl
    kind: ClusterBuildStrategy
  paramValues:
    - name: dockerfile
      value: Dockerfile
  output:
    image: image-registry.openshift-image-registry.svc:5000/openshift-builds/rfipconfig-be:latest
    pushSecret: pipeline-push-secret
```

적용 및 등록 확인:

```bash
oc apply -f rfipconfig-be.yaml
oc get builds.shipwright.io -n openshift-builds
# 두 Build 모두 REGISTERED=True 여야 함. (`oc get build`는 build.openshift.io로 해석되므로 사용 금지)
```

